@{
    ViewData["Title"] = "Home";
}

<section class="raceday-hero">
    <div class="hero-content">
        <span class="hero-tag">YOUR RACE. YOUR JOURNEY.</span>

        <h1>MAKE EVERY<br /><span>STEP COUNT.</span></h1>

        <p>
            Discover exciting running and cycling events,
            explore race categories and find your next challenge
            with RaceDay.
        </p>

        <div class="hero-buttons">
            <a asp-controller="Events" asp-action="Index" class="hero-btn primary-btn">
                Explore Events
            </a>

            <a asp-controller="Categories" asp-action="Index" class="hero-btn secondary-btn">
                Explore Categories
            </a>
        </div>

        <div class="hero-stats">
            <div>
                <h3>RUN</h3>
                <span>Push your limits</span>
            </div>

            <div>
                <h3>CYCLE</h3>
                <span>Find your pace</span>
            </div>

            <div>
                <h3>ACHIEVE</h3>
                <span>Reach your goals</span>
            </div>
        </div>
    </div>

    <div class="hero-decoration">
        <div class="circle circle-one"></div>
        <div class="circle circle-two"></div>
        <div class="hero-number">01</div>
        <div class="hero-side-text">RACEDAY MANAGEMENT</div>
    </div>
</section>

<section class="explore-section">
    <div class="section-heading">
        <div>
            <span class="section-label">EXPLORE RACEDAY</span>
            <h2>Everything starts here.</h2>
        </div>

        <p>Find your next event, discover categories and explore race routes.</p>
    </div>

    <div class="explore-grid">

        <a asp-controller="Events" asp-action="Index" class="explore-card">
            <span class="card-number">01</span>
            <div class="card-icon">🏁</div>
            <h3>Race Events</h3>
            <p>Discover upcoming races and exciting community events.</p>
            <span class="card-link">Explore events →</span>
        </a>

        <a asp-controller="Categories" asp-action="Index" class="explore-card">
            <span class="card-number">02</span>
            <div class="card-icon">🏃</div>
            <h3>Race Categories</h3>
            <p>Explore running, cycling and different race distances.</p>
            <span class="card-link">View categories →</span>
        </a>

        <a asp-controller="Routes" asp-action="Index" class="explore-card">
            <span class="card-number">03</span>
            <div class="card-icon">📍</div>
            <h3>Race Routes</h3>
            <p>Discover routes and distances for upcoming challenges.</p>
            <span class="card-link">Explore routes →</span>
        </a>

    </div>
</section>

<section class="join-section">
    <div>
        <span class="section-label">BE PART OF THE MOVEMENT</span>
        <h2>Your next challenge<br />starts today.</h2>
        <p>Join the RaceDay community and get ready for your next race.</p>
    </div>

    <a asp-controller="Account" asp-action="Register" class="hero-btn primary-btn">
        Get Started →
    </a>
</section>