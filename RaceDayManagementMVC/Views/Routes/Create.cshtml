@model RaceDayManagementMVC.Models.RouteViewModel

@{
    ViewData["Title"] = "Create Route";
}

<div class="management-container">
    <div class="management-header">
        <span class="eyebrow">RACEDAY MANAGEMENT</span>
        <h1>Create Route</h1>
        <p>Add a route for a sporting event.</p>
    </div>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="EventId"></label>
            <input asp-for="EventId" type="number" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="RouteName"></label>
            <input asp-for="RouteName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="DistanceKm"></label>
            <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="RouteDescription"></label>
            <textarea asp-for="RouteDescription" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="RouteMapUrl"></label>
            <input asp-for="RouteMapUrl" class="form-control" />
        </div>

        <button type="submit" class="btn-primary-custom">Create Route</button>
        <a asp-action="Index" class="btn-secondary-custom">Cancel</a>
    </form>
</div>