@model RaceDayManagementMVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="management-container">
    <div class="management-header">
        <span class="eyebrow">RACEDAY MANAGEMENT</span>
        <h1>Edit Race Category</h1>
        <p>Update the details of this race category.</p>
    </div>

    <div class="management-card">
        <form asp-action="Edit" asp-route-id="@Model.CategoryId" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="CategoryId" />

            <div class="mb-4">
                <label asp-for="CategoryName" class="form-label">
                    Category Name
                </label>

                <input asp-for="CategoryName"
                       class="form-control"
                       placeholder="e.g. 10 KM Run" />

                <span asp-validation-for="CategoryName"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Describe this race category..."></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary-custom">
                    Save Changes →
                </button>

                <a asp-action="Index" class="btn-secondary-custom">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>
