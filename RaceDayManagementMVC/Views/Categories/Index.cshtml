@model List<RaceDayManagementMVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="management-container">

    <div class="management-header">
        <span class="eyebrow">RACEDAY ADMINISTRATION</span>
        <h1>Manage Categories</h1>
        <p>Create, update and manage your race categories.</p>
    </div>

    <div class="management-toolbar">
        <div>
            <h3>Race Categories</h3>
            <p>@Model.Count categories available</p>
        </div>

        <a asp-action="Create" class="btn-primary-custom">
            + Add Category
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="management-grid">

        @foreach (var category in Model)
        {
            <div class="management-card">

                <div class="category-icon">🏁</div>

                <h4>@category.CategoryName</h4>

                <p>@category.Description</p>

                <div class="form-actions">

                    <a asp-action="Edit"
                       asp-route-id="@category.CategoryId"
                       class="btn-secondary-custom">
                        Edit
                    </a>

                    <form asp-action="Delete"
                          asp-route-id="@category.CategoryId"
                          method="post"
                          onsubmit="return confirm('Are you sure you want to delete this category?');">

                        <button type="submit" class="btn-danger-custom">
                            Delete
                        </button>

                    </form>

                </div>
            </div>
        }

    </div>

</div>